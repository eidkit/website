{"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1","type":"text"},{"text":" ","type":"text"},{"text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet","type":"text"},{"text":" ","type":"text"},{"text":"access to the ICAO applet from within an AID1 secure messaging session.","type":"text"},{"text":" ","type":"text"},{"text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"title":"PassiveAuthStatus.notSupported","modules":[{"name":"EidKit"}],"role":"symbol","roleHeading":"Case","symbolKind":"case","externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}]},"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EidKit/documentation/EidKit":{"url":"\/documentation\/eidkit","abstract":[],"kind":"s