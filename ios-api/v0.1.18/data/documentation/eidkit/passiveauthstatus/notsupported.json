{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1","type":"text"},{"text":" ","type":"text"},{"text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet","type":"text"},{"text":" ","type":"text"},{"text":"access to the ICAO applet from within an AID1 secure messaging session.","type":"text"},{"text":" ","type":"text"},{"text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"sections":[],"identifier":{"url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","interfaceLanguage":"swift"},"metadata":{"role":"symbol","title":"PassiveAuthStatus.notSupported","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"symbolKind":"case","modules":[{"name":"EidKit"}],"externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"references":{"doc://EidKit/documentation/EidKit/PassiveAuthStatus/notSupported":{"role":"symbol","title":"PassiveAuthStatus.notSupported","kind":"symbol","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"url":"\/documentation\/eidkit\/passiveauthstatus\/notsupported","abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}]},"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassiveAuthStatus","kind":"identifier"}],"title":"PassiveAuthStatus","type":"topic","navigatorTitle":[{"text":"PassiveAuthStatus","kind":"identifier"}],"abstract":[{"type":"text","text":"Result of passive authentication — verifies that the data on the card was signed by the"},{"type":"text","text":" "},{"type":"text","text":"Romanian state (MAI) and has not been tampered with."}],"url":"\/documentation\/eidkit\/passiveauthstatus","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus","role":"symbol"},"doc://EidKit/documentation/EidKit":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/eidkit","identifier":"doc:\/\/EidKit\/documentation\/EidKit","abstract":[],"title":"EidKit"}}}