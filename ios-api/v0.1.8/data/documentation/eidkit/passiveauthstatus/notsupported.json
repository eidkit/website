{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"metadata":{"externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"title":"PassiveAuthStatus.notSupported","modules":[{"name":"EidKit"}],"symbolKind":"case","role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1"},{"type":"text","text":" "},{"type":"text","text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet"},{"type":"text","text":" "},{"type":"text","text":"access to the ICAO applet from within an AID1 secure messaging session."},{"type":"text","text":" "},{"type":"text","text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"]}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"identifier":{"url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","interfaceLanguage":"swift"},"references":{"doc://EidKit/documentation/EidKit":{"abstract":[],"identifier":"doc:\/\/EidKit\/documentati