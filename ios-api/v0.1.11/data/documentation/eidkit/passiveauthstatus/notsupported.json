{"abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"identifier":{"url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1"},{"type":"text","text":" "},{"type":"text","text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet"},{"type":"text","text":" "},{"type":"text","text":"access to the ICAO applet from within an AID1 secure messaging session."},{"type":"text","text":" "},{"type":"text","text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","roleHeading":"Case","role":"symbol","symbolKind":"case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"title":"PassiveAuthStatus.notSupported","modules":[{"name":"EidKit"}]},"references":{"doc://EidKit/documentation/EidKit":{"url":"\/documentation\/eidkit","title":"EidKit","identifier":"doc:\/\/EidKit\/documentation\/EidKit","role":"collection","type":"topic","kind":"symbol","abstract":[]},"doc://EidKit/documentation/EidKit/PassiveAuthStatus/notSupported":{"abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"title":"PassiveAuthStatus.notSupported","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","kind":"symbol","url":"\/documentation\/eidkit\/passiveauthstatus\/notsupported","type":"topic","role":"symbol"},"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassiveAuthStatus"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PassiveAuthStatus"}],"url":"\/documentation\/eidkit\/passiveauthstatus","title":"PassiveAuthStatus","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Result of passive authentication — verifies that the data on the card was signed by the"},{"type":"text","text":" "},{"type":"text","text":"Romanian state (MAI) and has not been tampered with."}],"identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"}}}