{"abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"sections":[],"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"languages":["swift"]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1","type":"text"},{"text":" ","type":"text"},{"text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet","type":"text"},{"text":" ","type":"text"},{"text":"access to the ICAO applet from within an AID1 secure messaging session.","type":"text"},{"text":" ","type":"text"},{"text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"metadata":{"title":"PassiveAuthStatus.notSupported","externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","role":"symbol","symbolKind":"case","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"modules":[{"name":"EidKit"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"fragments":[{"text":"enum","kind":"k