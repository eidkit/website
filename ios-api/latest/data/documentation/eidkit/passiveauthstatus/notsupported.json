{"metadata":{"role":"symbol","modules":[{"name":"EidKit"}],"roleHeading":"Case","symbolKind":"case","externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","title":"PassiveAuthStatus.notSupported","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1","type":"text"},{"text":" ","type":"text"},{"text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet","type":"text"},{"text":" ","type":"text"},{"text":"access to the ICAO applet from within an AID1 secure messaging session.","type":"text"},{"text":" ","type":"text"},{"text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"references":{"doc://EidKit/documentation/EidKit":{"type":"topic","identifier":"doc:\/\/EidKit\/documentat