{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"metadata":{"externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","roleHeading":"Case","symbolKind":"case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"title":"PassiveAuthStatus.notSupported","role":"symbol","modules":[{"name":"EidKit"}]},"kind":"symbol","sections":[],"abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1"},{"type":"text","text":" "},{"type":"text","text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet"},{"type":"text","text":" "},{"type":"text","text":"access to the ICAO applet from within an AID1 secure messaging session."},{"type":"text","text":" "},{"type":"text","text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"references":{"doc://EidKit/documentation/EidKit/PassiveAuthStatus/notSupported":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"kind":"symbol","role":"symbol","abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"title":"PassiveAuthStatus.notSupported","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","type":"topic","url":"\/documentation\/eidkit\/passiveauthstatus\/notsupported"},"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"navigatorTitle":[{"text":"PassiveAuthStatus","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassiveAuthStatus","kind":"identifier"}],"title":"PassiveAuthStatus","abstract":[{"type":"text","text":"Result of passive authentication — verifies that the data on the card was signed by the"},{"type":"text","text":" "},{"type":"text","text":"Romanian state (MAI) and has not been tampered with."}],"type":"topic","url":"\/documentation\/eidkit\/passiveauthstatus","kind":"symbol","role":"symbol","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"},"doc://EidKit/documentation/EidKit":{"identifier":"doc:\/\/EidKit\/documentation\/EidKit","abstract":[],"type":"topic","kind":"symbol","url":"\/documentation\/eidkit","title":"EidKit","role":"collection"}}}