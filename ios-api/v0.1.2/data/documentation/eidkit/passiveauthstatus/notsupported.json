{"sections":[],"metadata":{"symbolKind":"case","roleHeading":"Case","title":"PassiveAuthStatus.notSupported","role":"symbol","modules":[{"name":"EidKit"}],"externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1"},{"type":"text","text":" "},{"type":"text","text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet"},{"type":"text","text":" "},{"type":"text","text":"access to the ICAO applet from within an AID1 secure messaging session."},{"type":"text","text":" "},{"type":"text","text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"]}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"references":{"doc://EidKit/documentation/EidKit":{"kind":"symbol","role":"collection","identifier":"doc:\