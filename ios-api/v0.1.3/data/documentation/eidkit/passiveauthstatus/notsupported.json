{"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1"},{"type":"text","text":" "},{"type":"text","text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet"},{"type":"text","text":" "},{"type":"text","text":"access to the ICAO applet from within an AID1 secure messaging session."},{"type":"text","text":" "},{"type":"text","text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"roleHeading":"Case","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"notSupported","kind":"identifier"}],"title":"PassiveAuthStatus.notSupported","role":"symbol","externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","symbolKind":"case","modules":[{"name":"EidKit"}]},"identifier":{"url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","interfaceLanguage":"swift"},"references":{"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"kind":"symbol","title":"PassiveAuthStatus","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassiveAuthStatus"}],"type":"topic","abstract":[{"text":"Result of passive authentication — verifies that the data on the card was signed by the","type":"text"},{"text":" ","type":"text"},{"text":"Romanian state (MAI) and has not been tampered with.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassiveAuthStatus"}],"url":"\/documentation\/eidkit\/passiveauthstatus","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"},"doc://EidKit/documentation/EidKit/PassiveAuthStatus/notSupported":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"url":"\/documentation\/eidkit\/passiveauthstatus\/notsupported","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"title":"PassiveAuthStatus.notSupported","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"doc://EidKit/documentation/EidKit":{"abstract":[],"role":"collection","kind":"symbol","identifier":"doc:\/\/EidKit\/documentation\/EidKit","title":"EidKit","url":"\/documentation\/eidkit","type":"topic"}}}