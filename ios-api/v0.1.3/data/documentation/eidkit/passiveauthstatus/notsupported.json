{"metadata":{"symbolKind":"case","title":"PassiveAuthStatus.notSupported","externalID":"s:6EidKit17PassiveAuthStatusO12notSupportedyA2CmF","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"roleHeading":"Case","modules":[{"name":"EidKit"}],"role":"symbol"},"abstract":[{"type":"text","text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)"},{"type":"text","text":" "},{"type":"text","text":"are not accessible in the current session context."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"On iOS, this occurs because the system NFC stack always pre-selects the national AID1","type":"text"},{"text":" ","type":"text"},{"text":"applet before the SDK receives the tag. The card’s security policy blocks cross-applet","type":"text"},{"text":" ","type":"text"},{"text":"access to the ICAO applet from within an AID1 secure messaging session.","type":"text"},{"text":" ","type":"text"},{"text":"This is a platform constraint, not an SDK error. Passive auth works normally on Android.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/eidkit\/passiveauthstatus\/notsupported"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"]]},"references":{"doc://EidKit/documentation/EidKit/PassiveAuthStatus/notSupported":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notSupported"}],"identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus\/notSupported","kind":"symbol","role":"symbol","abstract":[{"text":"Passive auth could not be performed because the card’s ICAO data group files (SOD\/DG2\/DG7)","type":"text"},{"text":" ","type":"text"},{"text":"are not accessible in the current session context.","type":"text"}],"title":"PassiveAuthStatus.notSupported","type":"topic","url":"\/documentation\/eidkit\/passiveauthstatus\/notsupported"},"doc://EidKit/documentation/EidKit/PassiveAuthStatus":{"role":"symbol","url":"\/documentation\/eidkit\/passiveauthstatus","title":"PassiveAuthStatus","abstract":[{"text":"Result of passive authentication — verifies that the data on the card was signed by the","type":"text"},{"text":" ","type":"text"},{"text":"Romanian state (MAI) and has not been tampered with.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"PassiveAuthStatus","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassiveAuthStatus","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/PassiveAuthStatus"},"doc://EidKit/documentation/EidKit":{"title":"EidKit","abstract":[],"role":"collection","url":"\/documentation\/eidkit","kind":"symbol","identifier":"doc:\/\/EidKit\/documentation\/EidKit","type":"topic"}}}