ributes: [","        \"sdk.name\": AttributeValue.string(\"eidkit-ios\"),","        \"deployment.environment\": AttributeValue.string(\"production\"),","    ]))","    .build()","EidKit.configure(EidKitConfig(tracerProvider: provider))"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/EidKit\/documentation\/EidKit","doc:\/\/EidKit\/documentation\/EidKit\/EidKitConfig"]]},"metadata":{"title":"tracerProvider","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tracerProvider","kind":"identifier"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:16OpenTelemetryApi14TracerProviderP","text":"TracerProvider","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"role":"symbol","externalID":"s:6EidKit0aB6ConfigV14tracerProvider16OpenTelemetryApi06TracerE0_pSgvp","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"EidKit"}]},"abstract":[{"text":"OpenTelemetry ","type":"text"},{"code":"TracerProvider","type":"codeVoice"},{"text":" for session telemetry.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/eidkit\/eidkitconfig\/tracerprovider"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EidKit/documentation/EidKit":{"title":"EidKit","abstract":[],"role":"collection","url":"\/documentation\/eidkit","kind":"symbol","identifier":"doc:\/\/EidKit\/documentation\/EidKit","type":"topic"},"doc://EidKit/documentation/EidKit/EidKitConfig":{"abstract":[{"text":"Configuration for the EidKit SDK.","type":"text"}],"role":"symbol","title":"EidKitConfig","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EidKitConfig","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/eidkit\/eidkitconfig","identifier":"doc:\/\/EidKit\/documentation\/EidKit\/EidKitConfig","navigatorTitle":[{"text":"EidKitConfig","kind":"identifier"}]},"doc://EidKit/documentation/EidKit/EidKitConfig/tracerProvider":{"type":"to